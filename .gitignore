# PlatformIO
.pio/
.platformio/

# Editor / IDE
.vscode/*.log
.idea/
.history/
*.swp
*.swo

# OS junk
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc

# Logs / temp
*.log
*.tmp
*.bak

# Claude Code — local harness config (personal, not for the repo)
.claude/settings.local.json

# Velxio emulation — per-run evidence bundles (reports, logs, screenshots)
# (**/ so every versions/*/emulation/runs/ is ignored)
**/emulation/runs/
pcb/kicad/*.bak6

# 3D exports: the finished models ARE tracked (pcb/3d/*.glb, *.step) so anyone
# cloning gets a rotatable board without a KiCad toolchain. Only the fetched
# upstream component-body cache stays out: those are verbatim third-party
# files from the KiCad 3D library, re-downloaded in seconds by
# pcb/tools/export_3d.sh, and vendoring someone else's library is a separate
# decision from shipping our own output.
pcb/3d/models/
